# ==============================================
# LLM Twin - Portfolio Project Configuration
# ==============================================

# --- Required for RAG Functionality ---

# OpenAI Config (Used for Embeddings/Reranking if not mocked)
OPENAI_MODEL_ID=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Huggingface Config (For loading tokenizers)
HUGGINGFACE_ACCESS_TOKEN=your_hf_token_here

# --- Optional / Production MLOps Settings ---

# Comet ML (Experiment Tracking)
COMET_API_KEY=

# MongoDB (Data Warehouse)
DATABASE_HOST="mongodb://codeatlas:codeatlas@127.0.0.1:27017"

# Qdrant (Vector Database)
USE_QDRANT_CLOUD=false
QDRANT_CLOUD_URL=
QDRANT_APIKEY=

# AWS Config (Only if you want to deploy to cloud)
AWS_ARN_ROLE=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

QDRANT_DATABASE_PORT=6335

USE_OLLAMA=false
OLLAMA_MODEL_ID=llama3.2:3b
# OLLAMA_MODEL_ID=llama3:8b-instruct-q4_K_M

# Neo4j (Graph DB)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Groq (live demo backend, spec §2.6) — checked before USE_OLLAMA in get_llm()
USE_GROQ=false
GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-120b

# Modal + vLLM (eval/ablation backend, spec §2.6)
# Each account needs BOTH values — token_id ("ak-...") alone will not authenticate.
MODAL_API_KEY=
MODAL_TOKEN_SECRET=
MODAL_API_KEY_2=
MODAL_TOKEN_SECRET_2=
MODAL_API_KEY_3=
MODAL_TOKEN_SECRET_3=
MODAL_API_KEY_4=
MODAL_TOKEN_SECRET_4=
# MODAL_VLLM_BASE_URL=  # set after `modal deploy scripts/deploy_modal_vllm.py`